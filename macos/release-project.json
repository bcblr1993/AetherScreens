{
  "name": "AetherScreensMacRelease",
  "options": {"bundleIdPrefix": "com.aethernative", "developmentLanguage": "en"},
  "packages": {"AetherScreens": {"path": ".."}},
  "targets": {
    "AetherScreens": {
      "type": "application", "platform": "macOS", "deploymentTarget": "14.0",
      "sources": [
        {"path": "../Sources/AetherScreensApp/main.swift"},
        {"path": "../Sources/AetherScreensAppIntents/SavedComputerIntents.swift"},
        {"path": "../assets/localization"},
        {"path": "../assets/branding/AppIcon-v1.icns", "buildPhase": "resources"},
        {"path": "../assets/licenses/BigInt-MIT.txt", "buildPhase": "resources"}
      ],
      "dependencies": [
        {"package": "AetherScreens", "product": "AetherScreensCore"},
        {"sdk": "AppIntents.framework"},
        {"target": "AetherScreensWidgets", "embed": true}
      ],
      "info": {
        "path": "build/ReleaseHost-Info.plist",
        "properties": {
          "AetherScreensShortcutCatalogSuite": "com.aethernative.aetherscreens",
          "AetherScreensWidgetGroupIdentifier": "group.com.aethernative.aetherscreens",
          "CFBundleDisplayName": "AetherScreens", "CFBundleName": "AetherScreens",
          "CFBundleIconFile": "AppIcon-v1",
          "CFBundleShortVersionString": "$(MARKETING_VERSION)",
          "CFBundleVersion": "$(CURRENT_PROJECT_VERSION)",
          "CFBundleDevelopmentRegion": "en", "CFBundleLocalizations": ["en", "zh-Hans"],
          "NSPrincipalClass": "NSApplication", "NSHighResolutionCapable": true,
          "NSHumanReadableCopyright": "Copyright © 2026 Aether Native.",
          "NSLocalNetworkUsageDescription": "Discover nearby Macs with Screen Sharing enabled.",
          "NSMicrophoneUsageDescription": "Use the microphone for on-device dictation. Review text before sending it to the remote computer.",
          "NSSpeechRecognitionUsageDescription": "Recognize dictation on this device before you choose to send the text to the remote computer.",
          "NSBonjourServices": ["_rfb._tcp", "_apple-sas._tcp"],
          "CFBundleURLTypes": [
            {"CFBundleURLName": "com.aethernative.aetherscreens.connection", "CFBundleURLSchemes": ["aetherscreens"], "CFBundleTypeRole": "Viewer"},
            {"CFBundleURLName": "com.aethernative.aetherscreens.vnc", "CFBundleURLSchemes": ["vnc"], "CFBundleTypeRole": "Viewer", "LSHandlerRank": "Alternate"}
          ]
        }
      },
      "settings": {"base": {
        "PRODUCT_BUNDLE_IDENTIFIER": "com.aethernative.aetherscreens",
        "SWIFT_VERSION": "5.9", "OTHER_SWIFT_FLAGS": "$(inherited) -parse-as-library",
        "MARKETING_VERSION": "1.0.0", "CURRENT_PROJECT_VERSION": "1",
        "ENABLE_APP_SANDBOX": "NO",
        "CODE_SIGN_ENTITLEMENTS": "../assets/AetherScreensMacReleaseHost.entitlements"
      }}
    },
    "AetherScreensWidgets": {
      "type": "app-extension", "platform": "macOS", "deploymentTarget": "14.0",
      "sources": [{"path": "../Sources/AetherScreensWidgets"}, {"path": "../assets/widget-localization"}],
      "dependencies": [
        {"sdk": "WidgetKit.framework"}, {"sdk": "AppIntents.framework"},
        {"package": "AetherScreens", "product": "AetherScreensWidgetSupport"}
      ],
      "info": {"path": "build/ReleaseWidgets-Info.plist", "properties": {
        "CFBundleDisplayName": "AetherScreens Widgets",
        "CFBundleShortVersionString": "$(MARKETING_VERSION)", "CFBundleVersion": "$(CURRENT_PROJECT_VERSION)",
        "CFBundleDevelopmentRegion": "en", "CFBundleLocalizations": ["en", "zh-Hans"],
        "AetherScreensWidgetGroupIdentifier": "group.com.aethernative.aetherscreens",
        "NSExtension": {"NSExtensionPointIdentifier": "com.apple.widgetkit-extension"}
      }},
      "settings": {"base": {
        "PRODUCT_BUNDLE_IDENTIFIER": "com.aethernative.aetherscreens.widgets",
        "CODE_SIGN_ENTITLEMENTS": "../assets/AetherScreensMacReleaseWidgets.entitlements",
        "APPLICATION_EXTENSION_API_ONLY": "YES", "ENABLE_APP_SANDBOX": "YES", "SKIP_INSTALL": "YES",
        "MARKETING_VERSION": "1.0.0", "CURRENT_PROJECT_VERSION": "1", "SWIFT_VERSION": "5.9"
      }}
    }
  }
}
